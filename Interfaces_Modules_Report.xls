<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40" xmlns:dt="uuid:C2F41010-65B3-11d1-A29F-00AA00C14882"><DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><Author>CIF Development Team</Author><LastAuthor>Jatindar Kumaar</LastAuthor><Created>2026-10-15T15:39:00Z</Created><LastSaved>2026-10-15T10:57:41Z</LastSaved></DocumentProperties><CustomDocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><ICV dt:dt="string">E5D76E55D0414FD5B8EB44105EEC9D41_12</ICV><KSOProductBuildVer dt:dt="string">1033-12.1.0.29162</KSOProductBuildVer><CalculationRule dt:dt="float">0</CalculationRule></CustomDocumentProperties><ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel"><WindowWidth>28800</WindowWidth><WindowHeight>12180</WindowHeight><ProtectStructure>False</ProtectStructure><ProtectWindows>False</ProtectWindows></ExcelWorkbook><Styles><Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Center"/><Borders/><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000"/><Interior/><NumberFormat/><Protection/></Style><Style ss:ID="s49"><Alignment ss:Vertical="Center"/><Borders/><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000"/><Interior/><NumberFormat/><Protection/></Style><Style ss:ID="s50"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/></Borders><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000" ss:Bold="1"/></Style><Style ss:ID="s51"><Alignment ss:Horizontal="Left" ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/></Borders><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000"/></Style><Style ss:ID="s52"><Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#000000"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#000000"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#000000"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#000000"/></Borders><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000" ss:Bold="1"/><Interior ss:Color="#F2F2F2" ss:Pattern="Solid"/></Style><Style ss:ID="s53"><Alignment ss:Horizontal="Center" ss:Vertical="Center"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/></Borders><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000"/></Style><Style ss:ID="s54"><Alignment ss:Horizontal="Left" ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/><Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/><Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/><Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#000000"/></Borders><Font ss:FontName="Times New Roman" x:CharSet="134" ss:Size="11" ss:Color="#000000"/></Style></Styles><Worksheet ss:Name="Interfaces &amp; Modules"><Table ss:ExpandedColumnCount="4" ss:ExpandedRowCount="65" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="48" ss:DefaultRowHeight="20"><Column ss:Index="1" ss:StyleID="s49" ss:AutoFitWidth="0" ss:Width="248.25"/><Column ss:Index="2" ss:StyleID="s49" ss:AutoFitWidth="0" ss:Width="280"/><Column ss:StyleID="s49" ss:AutoFitWidth="0" ss:Width="180"/><Column ss:StyleID="s49" ss:AutoFitWidth="0" ss:Width="420"/><Row ss:Height="22"><Cell ss:StyleID="s50"><Data ss:Type="String">Name:</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="22"><Cell ss:StyleID="s50"><Data ss:Type="String">UID:</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="22"><Cell ss:StyleID="s50"><Data ss:Type="String">Department</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="22"><Cell ss:StyleID="s50"><Data ss:Type="String">Total no. of interfaces/modules developed</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="Number">57</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="22"><Cell ss:StyleID="s50"><Data ss:Type="String">No. of interfaces/modules on new technology</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="Number">57</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="22"><Cell ss:StyleID="s50"><Data ss:Type="String">No. of interfaces/modules on old technology</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="Number">0</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="15"><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row ss:Height="26"><Cell ss:StyleID="s52"><Data ss:Type="String">S no.</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="String">Name of interface</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="String">New technology/old technology</Data></Cell><Cell ss:StyleID="s52"><Data ss:Type="String">Unique feature</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">CIF Portal Landing &amp; Home Page (Home)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Central institutional portal with facility overview, hero carousel, real-time stats, and research highlights</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">2</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Our Instruments Catalog (ourInstruments)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Categorized directory of laboratory instruments with real-time search, category filtering, and capability overviews</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">3</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Instrument Detailed Specification Profile (ourInstruments/:Name/:id/:categoryId)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Deep-linked equipment dossier detailing technical specifications, sample preparation guidelines, and tariff rates</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">4</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User Authentication Portal (Login)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Secure login portal for registered internal students, faculty members, and external industry researchers</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">5</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User Registration &amp; Onboarding (Register)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Multi-role onboarding registration with institutional affiliation verification and document validation</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">6</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Account Recovery &amp; Password Reset (recoverAccount)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Self-service account recovery with OTP/email verification and encrypted password reset workflow</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">7</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Upcoming Workshop &amp; Event Details (Events/:id)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Event agenda, speaker schedules, brochures, and registration portal for scientific instrumentation workshops</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">8</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Security Issue &amp; Credential Enforcement (SecurityIssue)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Mandatory security checkpoint for password policy compliance and account protection</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">9</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Researcher Profile Management (UserProfiles)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User profile configuration, academic department linkage, contact preferences, and research credentials</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">10</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">LPU Institutional Single Sign-On (LpuLogin)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Institutional credential single sign-on authentication interface for university students and faculty</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">11</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">CIF Facility Terms &amp; Conditions (CifTermsConditions)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Interactive compliance viewer for central facility guidelines, laboratory safety rules, and sample handling norms</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">12</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">New Instrument Slot Booking Wizard (NewBookings)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Interactive multi-step wizard to select instruments, test parameters, sample counts, and schedule testing slots</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">13</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User Bookings History &amp; Tracking (ViewBookings)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Real-time status tracking dashboard for all submitted instrument reservations and confirmation details</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">14</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Payment History &amp; Transaction Search (SearchPayments)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Searchable financial transaction ledger for verified payments, receipts, and downloadable tax invoices</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">15</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Search Pending Payments &amp; Dues (SearchPendingPayments)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Focused interface tracking unpaid instrument reservations, fee breakdowns, and payment deadlines</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">16</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Failed Payments Resolution Portal (FailedPayments)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Gateway payment failure diagnostics, transaction re-initiation, and offline challan submission fallback</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">17</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Live Booking Status Stepper (BookingStatus)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Visual step-by-step lifecycle tracker from slot request, approval, sample arrival, to test completion</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">18</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Test Results &amp; Data Download Center (BookingResult)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Secure download repository for instrument raw characterization data, spectrum charts, and signed test reports</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">19</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User Experience Feedback Form (FeedbackForm)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Feedback collection form rating instrument operational accuracy, operator guidance, and turnaround time</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">20</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Institutional Service Terms &amp; Policies (LpuTermsConditions)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">University guidelines detailing internal student/faculty subsidies, department quotas, and testing ethics</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">21</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Sample Physical Logistics Tracker (SampleStatus)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Sample shipment tracking monitoring physical arrival at central facility, queue order, and testing stage</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">22</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Payment Proof Verification Status (UploadProofStatus)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Verification status monitor for offline bank transfer slips, NEFT transaction IDs, and accounts sign-off</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">23</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User CIF MoU Agreement Interface (UserCIFMou)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Digital MoU submission and status monitor for collaborative partner universities and research institutions</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">24</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Technical Staff Authentication Portal (StaffLogins)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Dedicated authentication portal for lab technicians, instrument scientific officers, and operators</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">25</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff Action on Bookings Workbench (StaffActionBookings)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Operator workbench for approving, rescheduling, rejecting, and prioritizing assigned instrument testing slots</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">26</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff Uploaded Test Results Manager (MyUploads)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">File upload repository for operators to attach analyzed test spectra, tabular data files, and final reports</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">27</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff Payment Clearance Verification (PendingPaymentsS)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff-side payment audit interface ensuring fee clearance prior to loading physical samples on equipment</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">28</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff Update Sample Status (SampleStatusS)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Barcode and sample status controller allowing operators to log receipt, testing progress, and completion</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">29</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff User Feedback &amp; Grievance Review (UserFeedbackdetailsS)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Operator-level review dashboard to inspect user feedback, investigate sample issues, and improve lab service</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">30</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff Researcher Contact Directory (UserDetailSS)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Quick directory of researchers with active sample testing, facilitating direct technical clarifications</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">31</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Advanced Filter &amp; Search Bookings (SearchBookings)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Multi-criteria filtering by instrument model, user department, booking reference, and date range</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">32</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Pending Payments Reconciliation (PendingPayments)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Centralized ledger tracking unsettled invoices across all user categories awaiting accounts clearance</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">33</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Payment Response &amp; Gateway Handler (ResponsePayments)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Automated gateway callback processor handling transaction confirmations, failures, and digital receipts</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">34</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Staff Password Modification (ChangePassword)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Credential management and session security configuration for staff and lab operator accounts</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">35</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">CIF Interactive User Dashboard (cifDashboards)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Dynamic analytical hub featuring interactive ApexCharts, booking volumes, slot utilization, and alerts</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">36</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">New Analysis Method Configuration (NewAnalysis)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Administrative module for defining new sample characterization methods, parameters, and preparation limits</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">37</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">CIF Analysis &amp; Price Tariff CRUD (CifAnalysisCrud)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Full CRUD management for analysis tariffs across Internal (LPU), External Academic, and Industry user tiers</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">38</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Admin CIF MoU Management Panel (CifMouCrud)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Institutional MoU management, negotiated tariff structures, agreement validity tracking, and renewals</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">39</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Admin Payment Proof Verification Desk (AUploadProof)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Finance audit desk to verify uploaded bank deposit challans, NEFT reference numbers, and approve slot locks</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">40</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Events &amp; Workshops CRUD Console (EventCrud)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Administrative CRUD for creating, updating, and archiving hands-on workshops, webinars, and training sessions</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">41</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Admin Event Media &amp; Data Uploader (EventUploads)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Media management for uploading workshop promotional banners, speaker profiles, and informational brochures</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">42</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">All CIF Events &amp; Conference Overview (AllCIFEvents)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Centralized monitor overseeing participant registrations, attendee counts, and event execution logistics</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">43</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Super Admin Secure Gateway (AdminLoginX)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Elevated privilege authentication portal for facility administrators, directors, and system supervisors</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">44</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Master Booking Control &amp; Slot Overrides (ViewBookingsAdmins)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Master booking control room with powers to reallocate slots, declare emergency maintenance, and audit all requests</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">45</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Dynamic Instrument Tariff Updater (AdminInstrumentPrice)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Hourly and sample-based pricing matrix updater for instruments, testing categories, and consumables</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">46</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Instrument Maintenance &amp; Calibration Controller (AdminInstrumentAction)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Equipment lifecycle manager for scheduling calibration, recording downtime logs, and setting maintenance status</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">47</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">New Instrument Commissioning Wizard (NewInstrumentWizard)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Guided step-by-step setup wizard for commissioning new scientific instruments, technical specs, and booking parameters</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">48</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Test Assignment &amp; Workload Balancer (AssignTestCifA)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Intelligent workload distributor for allocating incoming test batches to qualified laboratory technicians</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">49</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Instrument Media &amp; Specification Asset Uploader (AdminUploadImage)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Gallery manager for uploading equipment photos, schematic optical diagrams, and downloadable spec brochures</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">50</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Admin Outstanding Receivables &amp; Financial Audit (PendingPaymentsA)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Institution-wide financial audit interface tracking total outstanding receivables and billing revenue statistics</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">51</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Super-Admin Sample Workflow Controller (SampleStatusAdmin)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Supervisory sample management panel with override powers across all testing stages in all laboratories</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">52</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Master User Directory &amp; RBAC Control (UserDetail)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Comprehensive user directory for account activation, role reassignment, and affiliation audits</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">53</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User Feedback &amp; Quality Governance (UserFeedbackdetails)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Facility-wide customer satisfaction analytics, ratings distribution, and complaint escalation management</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">54</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Researcher Profile &amp; Project Inspector (cifUserProfile)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Administrative inspection view examining researcher projects, publications, and facility utilization history</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">55</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">User-Specific Booking &amp; Test Log Audit (MyTestData/:loginName)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Granular administrative audit view filtering booking records, test files, and financial logs by individual user</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">56</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Institutional Policy &amp; Terms Management (LPUTermsCondition)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Administrative content editor for updating legal testing terms, sample retention rules, and conduct policies</Data></Cell></Row><Row ss:Height="28"><Cell ss:StyleID="s53"><Data ss:Type="Number">57</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Global Fallback &amp; Diagnostic Error Pages (error &amp; error/:type)</Data></Cell><Cell ss:StyleID="s53"><Data ss:Type="String">New technology</Data></Cell><Cell ss:StyleID="s54"><Data ss:Type="String">Centralized HTTP exception handling (404, 500, Unauthorized) with intelligent recovery navigation</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Layout x:Orientation="Landscape"/><Header x:Margin="0.3"/><Footer x:Margin="0.3"/><PageMargins x:Left="0.7" x:Right="0.7" x:Top="0.75" x:Bottom="0.75"/></PageSetup><Print><ValidPrinterInfo/><PaperSizeIndex>9</PaperSizeIndex><HorizontalResolution>600</HorizontalResolution><VerticalResolution>600</VerticalResolution></Print><Selected/><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><Panes><Pane><Number>3</Number><ActiveRow>3</ActiveRow><ActiveCol>0</ActiveCol><RangeSelection>R4C1</RangeSelection></Pane></Panes><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet></Workbook>