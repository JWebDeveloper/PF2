Options -MultiViews
RewriteEngine On
RewriteBase /cif/

# 1. API Proxy Rules (Your existing - unchanged)
RewriteRule ^api/header$ https://includepages.lpu.in/newlpu/header.php [L,P]
RewriteRule ^api/footer$ https://includepages.lpu.in/newlpu/footer.php [L,P]
RewriteRule ^api/remote-header$ https://includepages.lpu.in/newlpu/header.php [L,P]
RewriteRule ^api/remote-footer$ https://includepages.lpu.in/newlpu/footer.php [L,P]

# 2. Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. CRITICAL: Angular SPA Deep Linking - Rewrite ALL other requests to index.html
RewriteRule ^(.*)$ index.html [L]